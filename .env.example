# Copy this file to .env.local and replace the placeholder with your real key.
# Never commit .env.local.

# Gemini API key for the "Ask Binyam" assistant.
# Get one (free tier available): https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=replace_with_your_gemini_api_key

# Optional: override the default model used by the Persona API route.
# Model list: https://ai.google.dev/gemini-api/docs/models
PERSONA_AI_MODEL=gemini-3.5-flash-lite

# Contact form: sent from the server over SMTP (no third-party form service).
# Gmail works for free: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16-character code as SMTP_PASS.
# Any other SMTP provider (Outlook, Zoho, Brevo, Resend SMTP...) works with the same five values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=replace_with_your_app_password
# Where messages are delivered (defaults to the email in lib/persona/knowledge.ts).
CONTACT_TO=you@gmail.com
